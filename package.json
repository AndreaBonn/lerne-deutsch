{
  "name": "impara-tedesco",
  "version": "2.0.0",
  "private": true,
  "description": "Static German course. The manifest exists for the test toolchain only: the application itself has no runtime dependency and no build step.",
  "homepage": "https://andreabonn.github.io/impara-tedesco/",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:dom": "playwright test",
    "test:mutations": "node scripts/mutations.mjs",
    "test:all": "npm test && npm run test:mutations && npm run test:dom",
    "coverage": "node scripts/coverage.mjs",
    "validate": "node scripts/validate.mjs",
    "parity": "node scripts/parity.mjs",
    "check:precache": "node scripts/check_precache.mjs",
    "check:swversion": "node scripts/check_swversion.mjs",
    "check:live": "node scripts/check_live.mjs",
    "lint": "eslint .",
    "serve": "node scripts/serve.mjs",
    "snapshot:target": "node scripts/snapshot_target.mjs",
    "check:porting": "node scripts/check_porting.mjs",
    "review:lot": "node scripts/review_lot.mjs",
    "audio:strings": "node scripts/extract_strings.mjs",
    "audio:build": "uv run --script scripts/build_audio.py",
    "audio:prune": "node scripts/prune_audio.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
